# Server
NODE_ENV=development
PORT=4000
TRUST_PROXY=false
PUBLIC_URL=http://localhost:4000

# MySQL connection (ondemand database)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ondemand
DB_CONNECTION_LIMIT=10

# JWT (generate strong secrets, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=ondemand-backend
JWT_AUDIENCE=ondemand-admin
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Cookies (httpOnly auth tokens)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000
CORS_CREDENTIALS=true

# Rate limiting
RATE_STANDARD_WINDOW_MS=900000
RATE_STANDARD_MAX=300
RATE_AUTH_WINDOW_MS=900000
RATE_AUTH_MAX=10

# Account lockout
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_LOCK_MINUTES=15

# Password / reset
BCRYPT_ROUNDS=12
RESET_TOKEN_TTL_MINUTES=30
RESET_TOKEN_MAX_ATTEMPTS=5

# HTTPS / TLS (set TLS_ENABLED=true with key+cert to serve https directly)
TLS_ENABLED=false
TLS_KEY_PATH=
TLS_CERT_PATH=

# Media uploads.
# WEB_IMAGES_ROOT is where NEW uploads are written (default: ./uploads, git-ignored).
# LEGACY_WEB_IMAGES_ROOT is a read-only fallback holding media the existing rows
# still name by bare filename; it is never written to or deleted from.
# LEGACY_ARTWORK_ROOT is a second, FLAT read-only root: the in-app artwork (banner
# carousel pictures) the legacy product shipped, addressed with no folder in front.
WEB_IMAGES_ROOT=
LEGACY_WEB_IMAGES_ROOT=
LEGACY_ARTWORK_ROOT=
